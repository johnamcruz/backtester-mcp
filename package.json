{
  "name": "backtester-mcp",
  "version": "0.1.0",
  "description": "Replay broker MCP server: the futures-trading-harness broker interface over local historical bars, with a replay clock and simulated fills",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "backtester-mcp": "dist/index.js",
    "backtester-clock": "dist/clock.js",
    "backtester-build-store": "dist/build-store.js"
  },
  "files": [
    "dist",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "dev": "tsx src/index.ts",
    "clock": "node dist/clock.js",
    "build-store": "node dist/build-store.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "hyparquet": "^1.31.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "hyparquet-writer": "^0.16.12",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
