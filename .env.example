# ── Market data (required) ─────────────────────────────────────────────
# Folder of one-minute CSVs named <ROOT>_1min.csv (NQ_1min.csv, ES_1min.csv, ...),
# header datetime,open,high,low,close,volume; UTC timestamps (bar open time),
# oldest first; a back-adjusted continuous series per root. Micros replay their
# mini's file at the micro's tick value (MNQ->NQ, MES->ES, MYM->YM, M2K->RTY,
# MGC->GC, SIL->SI, MCL->CL). Local only: never commit data to this repo.
BACKTESTER_DATA_DIR=

# ── Replay clock (one required) ────────────────────────────────────────
# JSON file { "now": "<ISO time>" } the replay driver writes and advances.
# Re-read on every call; the server never uses the wall clock.
BACKTESTER_CLOCK_FILE=
# A fixed replay time, used when there is no clock file.
# BACKTESTER_NOW=2024-03-05T15:00:00Z

# ── Replay window (optional, ISO, UTC) ─────────────────────────────────
# Trading and the account start at START (bars before it stay available to
# get_bars as lookback history); nothing happens after END (get_bars is capped
# there and orders are refused). Orders are refused while the clock is outside.
# BACKTESTER_START=2024-03-01T00:00:00Z
# BACKTESTER_END=2024-04-01T00:00:00Z

# ── Run isolation ──────────────────────────────────────────────────────
# Each run keeps its account, orders, fills and journal in its own folder, so
# runs can go in parallel. Same data + window + clock sequence + orders = same fills.
# BACKTESTER_RUN_ID=default
# Default: ~/.backtester-mcp/runs/<BACKTESTER_RUN_ID>
# BACKTESTER_STATE_DIR=

# ── Simulated account and fills ────────────────────────────────────────
# BACKTESTER_ACCOUNT_ID=1
# BACKTESTER_ACCOUNT_NAME=BACKTEST-<run id>
# BACKTESTER_START_BALANCE=100000
# Ticks of slippage on every market fill and stop fill (limits fill without it).
# BACKTESTER_SLIPPAGE_TICKS=1
# Fees per side per contract.
# BACKTESTER_FEES_MICRO=0.37
# BACKTESTER_FEES_MINI=1.40

# ── Trading guardrails (same semantics as projectx-mcp) ────────────────
# Order-writing tools are refused unless this is true.
BACKTESTER_TRADING_ENABLED=false
# Comma-separated account IDs the model may trade. Empty = any.
BACKTESTER_ALLOWED_ACCOUNT_IDS=
# Comma-separated symbol roots the model may trade, e.g. MNQ,MES. Empty = any.
BACKTESTER_ALLOWED_SYMBOLS=
# Max contracts per order, and max absolute net position per contract.
BACKTESTER_MAX_ORDER_SIZE=1
BACKTESTER_MAX_POSITION_SIZE=2
# Stop opening new risk once realized P&L (net of fees) for the current
# trading day (starts 17:00 America/Chicago = 18:00 ET) is at or below -this value. 0 = off.
BACKTESTER_MAX_DAILY_LOSS=500

# ── Learning journal ───────────────────────────────────────────────────
# JSONL file (same format as projectx-mcp's; the harness's order gate reads it).
# Default: <BACKTESTER_STATE_DIR>/journal.jsonl
# BACKTESTER_JOURNAL_PATH=

# Load this file from elsewhere: BACKTESTER_ENV_FILE=/path/to/.env

# ── HTTP transport (optional) ──────────────────────────────────────────
# PORT=8787
# HOST=127.0.0.1
# Required for HTTP mode (16+ chars, e.g. `openssl rand -hex 32`).
# MCP_HTTP_AUTH_TOKEN=
